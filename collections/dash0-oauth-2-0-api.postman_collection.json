        {
          "id": "ed03fb84-7e23-461e-8547-8555e594cf76",
          "name": "OAuth 2.0 Authorization Endpoint (Unauthenticated)",
          "request": {
            "name": "OAuth 2.0 Authorization Endpoint (Unauthenticated)",
            "description": {
              "content": "Unauthenticated authorization endpoint (RFC 6749 section 3.1). Validates the client,\nredirect URI, PKCE parameters, and scopes. Creates a pending authorization request\nand always redirects to the consent UI.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "oauth",
                "authorize"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "response_type",
                  "value": "<string>",
                  "description": "(Required) Must be \"code\" for the authorization code flow."
                },
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) The client identifier obtained during registration."
                },
                {
                  "disabled": false,
                  "key": "redirect_uri",
                  "value": "<uri>",
                  "description": "(Required) Must match one of the client's registered redirect URIs."
                },
                {
                  "disabled": false,
                  "key": "scope",
                  "value": "<string>",
                  "description": "Space-separated list of requested scopes."
                },
                {
                  "disabled": false,
                  "key": "state",
                  "value": "<string>",
                  "description": "Opaque value for CSRF protection, returned unchanged in the redirect."
                },
                {
                  "disabled": false,
                  "key": "code_challenge",
                  "value": "<string>",
                  "description": "(Required) PKCE code challenge (RFC 7636)."
                },
                {
                  "disabled": false,
                  "key": "code_challenge_method",
                  "value": "<string>",
                  "description": "(Required) Must be \"S256\"."
                },
                {
                  "disabled": false,
                  "key": "prompt",
                  "value": "<string>",
                  "description": "Space-separated list of prompt directives. Supported value: \"consent\".\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
