            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.eu-west-1.aws.dash0.com/api/members/:memberID",
            "params": [
              {
                "name": "memberID",
                "value": "",
                "type": "path",
                "description": "The Clerk user ID of the member to remove."
              }
            ]
          },
          "docs": "Removes the given member from the organization."
        },
