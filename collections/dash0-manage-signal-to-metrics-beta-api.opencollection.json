      "items": [
        {
          "info": {
            "name": "Get a specific signal-to-metrics config by origin or ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.eu-west-1.aws.dash0.com/api/signal-to-metrics/:originOrId",
            "params": [
              {
                "name": "originOrId",
                "value": "",
                "type": "path",
                "description": "Signal-to-metrics config origin or UUID"
              },
              {
                "name": "dataset",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a specific signal-to-metrics configuration identified by its origin label or UUID."
        },
        {
          "info": {
            "name": "Update or create a signal-to-metrics config by origin or ID",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.eu-west-1.aws.dash0.com/api/signal-to-metrics/:originOrId",
            "params": [
              {
                "name": "originOrId",
                "value": "",
                "type": "path",
                "description": "Signal-to-metrics config origin or UUID"
              },
              {
                "name": "dataset",
                "value": "",
                "type": "query"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an existing signal-to-metrics configuration or creates a new one if it doesn't exist. Useful for Infrastructure-as-Code workflows."
        },
        {
          "info": {
            "name": "Delete a signal-to-metrics config by origin or ID",
            "type": "http"
