          "http": {
            "method": "DELETE",
            "url": "https://api.eu-west-1.aws.dash0.com/api/signal-to-metrics/:originOrId",
            "params": [
              {
                "name": "originOrId",
                "value": "",
                "type": "path",
                "description": "Signal-to-metrics config origin or UUID"
              },
              {
                "name": "dataset",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Deletes a specific signal-to-metrics configuration identified by its origin label or UUID."
        },
        {
          "info": {
            "name": "List all signal-to-metrics configs for the organization",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.eu-west-1.aws.dash0.com/api/signal-to-metrics",
            "params": [
              {
                "name": "dataset",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of items to return."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of items to skip."
              },
              {
                "name": "originPrefix",
                "value": "",
                "type": "query",
                "description": "Filter by origin prefix."
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Case-insensitive substring search on the rule name."
              },
              {
                "name": "signal",
                "value": "",
                "type": "query",
                "description": "Filter by signal type."
              },
              {
                "name": "enabled",
                "value": "",
                "type": "query",
                "description": "Filter by enabled state."
              }
            ]
          },
          "docs": "Returns all signal-to-metrics configurations for your organization."
        },
        {
          "info": {
            "name": "Create a new signal-to-metrics config",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.eu-west-1.aws.dash0.com/api/signal-to-metrics",
            "params": [
              {
                "name": "dataset",
