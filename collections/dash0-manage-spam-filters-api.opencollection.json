{
  "opencollection": "1.0.0",
  "info": {
    "name": "Dash0 Edge Collectors Manage Spam Filters API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Manage Spam Filters",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a specific spam filter by origin or ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.eu-west-1.aws.dash0.com/api/spam-filters/:originOrId",
            "params": [
              {
                "name": "originOrId",
                "value": "",
                "type": "path",
                "description": "Spam filter origin or UUID"
              },
              {
                "name": "dataset",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a specific spam filter identified by its origin label or UUID."
        },
        {
          "info": {
            "name": "Update or create a spam filter by origin or ID",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.eu-west-1.aws.dash0.com/api/spam-filters/:originOrId",
            "params": [
              {
                "name": "originOrId",
                "value": "",
                "type": "path",
                "description": "Spam filter origin or UUID"
              },
              {
                "name": "dataset",
                "value": "",
                "type": "query"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an existing spam filter or creates a new one if it doesn't exist.\nUseful for Infrastructure-as-Code workflows. Provide either structured `filter`\ncriteria or a raw OTTL `condition` in the spec, but not both.\n"
        },
        {
          "info": {
            "name": "Delete a spam filter by origin or ID",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.eu-west-1.aws.dash0.com/api/spam-filters/:originOrId",
            "params": [
              {
                "name": "originOrId",
                "value": "",
                "type": "path",
                "description": "Spam filter origin or UUID"
              },
              {
                "name": "dataset",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Deletes a specific spam filter identified by its origin label or UUID."
        },
        {
          "info": {
            "name": "List all spam filters for the organization",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.eu-west-1.aws.dash0.com/api/spam-filters",
            "params": [
              {
                "name": "dataset",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns all spam filters configured for your organization."
        },
        {
          "info": {
            "name": "Create a new spam filter",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.eu-west-1.aws.dash0.com/api/spam-filters",
            "params": [
              {
                "name": "dataset",
                "value": "",
                "type": "query"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new spam filter for your organization. Provide either structured `filter`\ncriteria or a raw OTTL `condition` in the spec, but not both.\n\nIf `metadata.labels[\"dash0.com/origin\"]` is provided, it must be unique within\nthe organization and dataset. A request with a duplicate origin returns 400.\nIf no origin is provided, the server auto-generates one (`api-<uuid>`).\n"
        }
      ]
    }
  ],
  "bundled": true
}